<UserControl x:Class="MediaSnap.Views.SessionItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MediaSnap.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MediaSessionViewModel}"
             d:DesignWidth="320">

    <Border Padding="8"
            Margin="0,2"
            CornerRadius="6"
            Background="#18FFFFFF">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Thumbnail / fallback icon -->
            <Border Grid.Column="0"
                    Width="48" Height="48"
                    CornerRadius="4"
                    Background="#30FFFFFF"
                    ClipToBounds="True">
                <Grid>
                    <!-- Thumbnail image -->
                    <Image Source="{Binding Thumbnail}"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>

                    <!-- Fallback: music note glyph -->
                    <TextBlock Text="&#xE8D6;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="20"
                               Foreground="#99FFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Text info -->
            <StackPanel Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center">

                <!-- App name + status indicator -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <Image Source="{Binding AppIcon}"
                           Width="14" Height="14"
                           Margin="0,0,4,0"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AppIcon}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <TextBlock Text="{Binding AppName, FallbackValue='Unknown App'}"
                               Foreground="#99FFFFFF"
                               FontSize="11" />
                </StackPanel>

                <!-- Title -->
                <TextBlock Text="{Binding Title, FallbackValue='No title'}"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="230"
                           HorizontalAlignment="Left" />

                <!-- Artist -->
                <TextBlock Text="{Binding Artist, FallbackValue=''}"
                           Foreground="#CCFFFFFF"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="230"
                           HorizontalAlignment="Left">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Artist}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
